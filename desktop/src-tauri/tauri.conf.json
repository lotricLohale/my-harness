{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDSH",
  "version": "0.1.0",
  "identifier": "com.lotriclohale.my-harness",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "title": "MDSH",
        "width": 520,
        "height": 420,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
