-export function safeError(error: unknown): string {
-  const raw = error instanceof Error ? error.message : String(error);
+export function safeError(error: unknown, depth = 0): string {
+  if (depth > 3) return "";
+  if (!(error instanceof Error)) return redactSecrets(String(error));
+  const code =
+    typeof (error as { code?: unknown }).code === "string"
+      ? (error as { code: string }).code
+      : undefined;
+  const cause =
+    error.cause !== undefined ? safeError(error.cause, depth + 1) : "";
+  const raw = [error.message, code && code !== error.message ? code : "", cause]
+    .filter(Boolean)
+    .join(": ");
   return redactSecrets(raw);
 }
